# Copy to .env (git-ignored) and fill in. Read by docker compose and by the backend
# when started from the IDE or ./gradlew bootRun.

# HMAC secret for JWT signing, at least 32 characters. Generate one with:
#   openssl rand -base64 48
JWT_SECRET=

# Optional overrides
# DB_USERNAME=nowme
# DB_PASSWORD=nowme
# SEED_ENABLED=true
# SEED_RESET=false
# SHOW_SQL=false
